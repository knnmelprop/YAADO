# Case data artifacts — NEVER commit raw geometry/mesh/results to git.
# Track via DVC if versioning is needed (pointer *.dvc files ARE tracked).
# (Global repo .gitignore already covers *.su2 *.cgns *.msh *.vtu *.dat *.cfg;
#  this adds CAD exchange formats, which the global list does not.)
cad/*.step
cad/*.stp
cad/*.STEP
cad/*.STP
cad/*.igs
cad/*.iges
geom/*
mesh/*
run/*
# keep the empty dirs and everything tracked here
!*/.gitkeep
!.gitignore
