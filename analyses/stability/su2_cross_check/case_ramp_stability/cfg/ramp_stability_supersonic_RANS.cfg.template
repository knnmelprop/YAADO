# MELprop-IADE | SU2 config template — ramP stability cross-check | v0.1.0
# ============================================================================
# Case:    ramP + interstage + booster, external-only, capped ramjet inlet
# Regime:  steady, compressible, supersonic RANS
# Purpose: static-stability sign check (CP vs CG -> static margin, caliber)
# ----------------------------------------------------------------------------
# THIS IS A TEMPLATE. `{{...}}` tokens MUST be filled by the config generator
# (or by hand) before running. The live, filled .cfg is written into the
# gitignored /runs/ tree — never commit a filled .cfg (global .gitignore
# ignores *.cfg on purpose).
#
# Run BOTH turbulence models as an independent cross-check (Heiser/plan):
#   KIND_TURB_MODEL = SA   (cheaper reference)
#   KIND_TURB_MODEL = SST  (control, esp. if sign-flip margin is near zero)
#
# SAFETY-CRITICAL — DO NOT FABRICATE:
#   REF_ORIGIN_MOMENT_* is the CG. Static margin is CP-CG; a wrong CG gives a
#   wrong stability sign. Provide the real CG, or SWEEP it and bound the result.
#   Same for REF_LENGTH / REF_AREA (from the real geometry). Leave as {{...}}
#   until a datasheet/CAD value exists.
# ============================================================================

% -------------------- PROBLEM DEFINITION --------------------
SOLVER= RANS
KIND_TURB_MODEL= {{TURB_MODEL}}        % SA  or  SST
MATH_PROBLEM= DIRECT
RESTART_SOL= NO

% -------------------- FREESTREAM (ASSUMPTION: fill from design point) --------
% PROVISIONAL default below = ISA @ 15 km (T=216.65 K, p=12111.6 Pa),
% Mach 2.5. Replace with the real design altitude/Mach once fixed.
MACH_NUMBER= {{MACH}}                  % PROVISIONAL 2.5
AOA= {{AOA_DEG}}                       % swept externally: {0, 4, 8} deg
SIDESLIP_ANGLE= 0.0
FREESTREAM_TEMPERATURE= {{FREESTREAM_TEMPERATURE_K}}   % PROVISIONAL 216.65
FREESTREAM_PRESSURE= {{FREESTREAM_PRESSURE_PA}}        % PROVISIONAL 12111.6
INIT_OPTION= TD_CONDITIONS
FREESTREAM_OPTION= TEMPERATURE_FS

% -------------------- FLUID / VISCOSITY --------------------
FLUID_MODEL= STANDARD_AIR
GAS_CONSTANT= 287.058
GAMMA_VALUE= 1.4
VISCOSITY_MODEL= SUTHERLAND

% -------------------- REFERENCE VALUES (from geometry — DO NOT FABRICATE) ----
REF_DIMENSIONALIZATION= DIMENSIONAL
REF_LENGTH= {{REF_LENGTH_M}}           % body length or diameter — pick a
                                       % convention and keep it consistent with
                                       % the caliber/static-margin post-proc
REF_AREA= {{REF_AREA_M2}}              % frontal (max cross-section) area
% Moment reference center == CG (SAFETY-CRITICAL — sweep if unknown):
REF_ORIGIN_MOMENT_X= {{CG_X_M}}
REF_ORIGIN_MOMENT_Y= 0.0
REF_ORIGIN_MOMENT_Z= 0.0

% -------------------- BOUNDARY CONDITIONS --------------------
% Marker names MUST match the mesh (see cfg/markers.md). Capped inlet => the
% inlet cap is a solid wall, not an inflow. Adiabatic viscous walls:
MARKER_HEATFLUX= ( body_wall, 0.0, booster_wall, 0.0, interstage_wall, 0.0, base_region, 0.0, inlet_cap, 0.0 )
MARKER_FAR= ( farfield )
% Half-model? uncomment:
% MARKER_SYM= ( symmetry )

% Force/moment integration over the full airframe:
MARKER_MONITORING= ( body_wall, booster_wall, interstage_wall, base_region, inlet_cap )
MARKER_PLOTTING= ( body_wall, booster_wall, interstage_wall, base_region, inlet_cap )

% -------------------- NUMERICS (tuned for supersonic) --------------------
NUM_METHOD_GRAD= WEIGHTED_LEAST_SQUARES
CFL_NUMBER= 2.0
CFL_ADAPT= YES
CFL_ADAPT_PARAM= ( 0.1, 1.2, 1.0, 50.0 )

CONV_NUM_METHOD_FLOW= ROE
MUSCL_FLOW= YES
SLOPE_LIMITER_FLOW= VENKATAKRISHNAN
VENKAT_LIMITER_COEFF= 0.05
ENTROPY_FIX_COEFF= 0.10                % NON-ZERO is important for supersonic Roe
TIME_DISCRE_FLOW= EULER_IMPLICIT

CONV_NUM_METHOD_TURB= SCALAR_UPWIND
MUSCL_TURB= NO
TIME_DISCRE_TURB= EULER_IMPLICIT

% -------------------- LINEAR SOLVER --------------------
LINEAR_SOLVER= FGMRES
LINEAR_SOLVER_PREC= ILU
LINEAR_SOLVER_ERROR= 1E-6
LINEAR_SOLVER_ITER= 10

% -------------------- CONVERGENCE --------------------
ITER= 8000
CONV_FIELD= RMS_DENSITY
CONV_RESIDUAL_MINVAL= -8
CONV_STARTITER= 10

% -------------------- I/O --------------------
MESH_FILENAME= {{MESH_FILENAME}}       % e.g. ../mesh/ramp_stability_v1.su2
MESH_FORMAT= SU2                       % or CGNS if meshed via Gmsh->CGNS
SOLUTION_FILENAME= solution_flow.dat
RESTART_FILENAME= restart_flow.dat
OUTPUT_FILES= ( RESTART, PARAVIEW, SURFACE_CSV )
VOLUME_OUTPUT= ( SOLUTION, PRIMITIVE )
CONV_FILENAME= history
SCREEN_OUTPUT= ( INNER_ITER, RMS_DENSITY, RMS_ENERGY, LIFT, DRAG, MOMENT_Z )
HISTORY_OUTPUT= ( ITER, RMS_RES, AERO_COEFF )
WRT_FORCES_BREAKDOWN= YES              % writes forces_breakdown.dat (CL/CD/CM)
OUTPUT_WRT_FREQ= 250
