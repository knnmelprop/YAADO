$yaado-background: #0b0f17;      /* Deep Midnight - Root Canvas */
$yaado-surface: #111827;         /* Charcoal Panel - Primary Containers */
$yaado-panel: #1b2436;           /* Elevated Slate - Cards, Modals, Popovers */
$yaado-border-subtle: #25334a;   /* Subtle Border - Structural Lines */
$yaado-border-focus: #3b82f6;    /* Avionics Blue - Focus Ring */
$yaado-accent: #f59e0b;          /* Propulsion Amber - Highlights, Tab Underline, CTA */
$yaado-accent-hover: #d97706;    /* Amber Hover State */
$yaado-primary: #1d4ed8;         /* Deep Cobalt - Selection Fill & Cursor */
$yaado-secondary: #0284c7;       /* Avionics Cyan - Secondary Tags & Badges */
$yaado-success: #10b981;         /* Converged Green - Solver Success, Valid Input */
$yaado-warning: #f59e0b;         /* Advisory Amber - Non-fatal Warnings */
$yaado-error: #ef4444;           /* Abort Red - Failure, Solver Divergence */
$yaado-text: #f8fafc;            /* Telemetry White - Data Values & Headings */
$yaado-text-muted: #94a3b8;      /* Silver Slate - Units, Labels, Keys */
$yaado-text-disabled: #475569;   /* Muted Slate - Passive Framing & Timestamps */

/* ==========================================================================
   Root Layout & Chrome
   ========================================================================== */

App, Screen {
    background: ansi_default;
    color: $yaado-text;
}

Footer {
    dock: bottom;
    height: 1;
    background: ansi_default;
    color: $yaado-text-muted;
}

FooterKey {
    background: transparent;
}

FooterKey .footer-key--key {
    background: transparent;
    color: $yaado-accent;
}

FooterKey .footer-key--description {
    background: transparent;
    color: $yaado-text-muted;
}

FooterKey:hover {
    background: transparent;
}

FooterKey:hover .footer-key--key {
    background: transparent;
    color: $yaado-accent-hover;
}

FooterKey:hover .footer-key--description {
    background: transparent;
    color: $yaado-text;
}

FooterLabel {
    background: transparent;
    color: $yaado-text-muted;
}

/* ==========================================================================
   Navigation & Tabs (Clean 1-Row Minimalist Style)
   ========================================================================== */

/* Hide Textual's default sliding underline bar */
Underline {
    display: none;
}

TabbedContent {
    background: transparent;
    height: 1fr;
}

Tabs {
    background: transparent;
    dock: top;
    height: 1;
    margin: 0 1;
}

/* Inactive Tab: Subtle silver text, no border, no background box */
Tab {
    background: transparent;
    border: none;
    color: $yaado-text-muted;
    height: 1;
    padding: 0 2;
    margin-right: 1;
    text-style: none;
}

/* Hover: Crisp white */
Tab:hover {
    color: $yaado-text;
}

/* Active Tab: Bright Propulsion Amber text in bold */
Tab.-active, Tabs:focus Tab.-active {
    background: transparent;
    border: none;
    color: $yaado-accent;
    text-style: bold;
}

TabPane {
    padding: 1;
    background: transparent;
}

/* ==========================================================================
   Main Cockpit Layout
   ========================================================================== */

#main-layout {
    height: 1fr;
    width: 1fr;
}

#left-column {
    width: 1fr;
    height: 1fr;
    margin-right: 1;
}

#right-column {
    width: 2fr;
    height: 1fr;
}

.cockpit-card {
    border: round $yaado-border-subtle;
    border-title-color: $yaado-accent;
    border-title-style: bold;
    border-title-align: left;
    border-title-background: transparent;
    background: transparent;
    padding: 1;
    height: 1fr;
}

#hangar-card {
    margin-bottom: 1;
    padding-left: 1;
    padding-top: 1;
    padding-right: 1;
    padding-bottom: 0;
}

.cockpit-card:focus-within {
    border: round $yaado-border-focus;
}

#hangar-tree {
    background: transparent;
    padding: 0;
    scrollbar-size: 0 0;
    height: 1fr;
}

#hangar-tree:focus {
    background: transparent;
}

#hangar-tree > .tree--cursor {
    background: $yaado-primary;
    color: $yaado-text;
    text-style: bold;
}

#hangar-tree > .tree--guides {
    color: $yaado-border-subtle;
}

#hangar-tree > .tree--guides-hover {
    color: $yaado-accent;
}

#hangar-tree > .tree--highlight-line {
    background: transparent;
}

Button#new-vehicle-btn {
    width: 100%;
    height: 3;
    background: transparent;
    border: round $yaado-border-subtle;
    color: $yaado-text-muted;
    text-style: bold;
}

Button#new-vehicle-btn:hover {
    background: transparent;
    border: round $yaado-accent;
    color: $yaado-accent;
}

Button#new-vehicle-btn:focus {
    background: transparent;
    border: round $yaado-border-focus;
    color: $yaado-text;
}

#preview-content {
    width: 100%;
    height: 100%;
    padding: 0 1;
    color: $yaado-text;
    overflow-y: auto;
}

/* ==========================================================================
   Hangar Workspace Layout
   ========================================================================== */

#hangar-layout {
    height: 1fr;
    width: 1fr;
}

#componentstore-card {
    width: 1fr;
    height: 1fr;
    margin-right: 1;
}

#hangar-right-column {
    width: 3fr;
    height: 1fr;
}

#panel-and-hangar {
    height: 1.5fr;
    width: 1fr;
    margin-bottom: 1;
}

#workspace-card {
    width: 2fr;
    height: 1fr;
    margin-right: 1;
}

#hangar-library-card {
    width: 1fr;
    height: 1fr;
}

#component-preview-card {
    height: 1fr;
    width: 1fr;
}

#component-preview {
    width: 100%;
    height: 100%;
    content-align: center middle;
    text-align: center;
    color: $yaado-text-muted;
}

/* ==========================================================================
   Flight Deck Workspace Layout
   ========================================================================== */

#flightdeck-layout {
    height: 1fr;
    width: 1fr;
}

#flightdeck-solvers-card {
    width: 1fr;
    height: 1fr;
    margin-right: 1;
}

#flightdeck-middle-column {
    width: 2fr;
    height: 1fr;
    margin-right: 1;
}

#flightdeck-pipeline-card {
    height: 1fr;
}

#flightdeck-results-card {
    height: 1fr;
    margin-bottom: 1;
}

#flightdeck-runs-card {
    width: 1fr;
    height: 1fr;
}

#flightdeck-runs-content {
    width: 100%;
    height: 100%;
    content-align: center middle;
    text-align: center;
    color: $yaado-text-muted;
}